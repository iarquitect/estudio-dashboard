# Copiá este archivo como .env.local para desarrollo local
# En Vercel, configurá estas variables en Project Settings → Environment Variables

# GitHub PAT con scope: actions:write (solo para el botón Retrain)
VITE_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Formato: owner/repo  (ej: matvillarruel/estudio-dashboard)
VITE_GITHUB_REPO=owner/estudio-dashboard
